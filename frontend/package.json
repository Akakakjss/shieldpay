{
  "name": "shieldpay-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/verify-browser.mjs",
    "format": "prettier --write src scripts vite.config.js index.html package.json",
    "format:check": "prettier --check src scripts vite.config.js index.html package.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "ag-grid-community": "35.3.0",
    "ag-grid-react": "35.3.0",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "^0.28.1",
    "jsdom": "28.1.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
